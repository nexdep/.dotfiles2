{{ if eq .machine "wsl" -}}
#!/bin/sh
# Mirror the shared WezTerm config into the Windows user's home so native
# Windows WezTerm uses the same settings.
# config hash: {{ include "dot_wezterm.lua" | sha256sum }}
set -eu
{{ include ".chezmoitemplates/windows-write-helpers.sh" }}

# No WSL interop (e.g. CI containers): nothing to do.
[ -e /proc/sys/fs/binfmt_misc/WSLInterop ] || exit 0
command -v cmd.exe >/dev/null 2>&1 || exit 0

resolve_windows_home() {
  # cd to a Windows filesystem path first: cmd.exe warns on UNC/Linux cwd.
  windows_home="$(
    cd /mnt/c &&
      cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r'
  )" || return
  [ -n "$windows_home" ] || return 1
  winhome="$(wslpath "$windows_home")" || return
  [ -d "$winhome" ]
}

if ! windows_retry "querying the Windows user profile" resolve_windows_home; then
  exit 0
fi

wezterm_target="$winhome/.wezterm.lua"
if windows_retry "synchronizing the Windows WezTerm config at $wezterm_target" \
  windows_atomic_copy_if_changed "$HOME/.wezterm.lua" "$wezterm_target"; then
  echo "windows wezterm config synchronized in $wezterm_target"
fi
{{ end -}}
