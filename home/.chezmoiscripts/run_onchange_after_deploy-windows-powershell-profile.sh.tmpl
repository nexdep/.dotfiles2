{{ if eq .machine "wsl" -}}
#!/bin/sh
# Replace the PowerShell 7 current-user/current-host profile on the Windows
# host with the profile managed by this repository.
# profile hash: {{ include ".chezmoitemplates/windows-powershell-profile.ps1" | sha256sum }}
set -eu

# No WSL interop (e.g. CI containers): nothing to do.
[ -e /proc/sys/fs/binfmt_misc/WSLInterop ] || exit 0
command -v pwsh.exe >/dev/null 2>&1 || exit 0

# cd to a Windows filesystem path first: Windows executables warn on a
# UNC/Linux cwd. -NoProfile ensures the existing profile cannot affect lookup.
if ! windows_profile="$(
  cd /mnt/c
  # $PROFILE must be expanded by PowerShell, not this POSIX shell.
  # shellcheck disable=SC2016
  pwsh.exe -NoLogo -NoProfile -NonInteractive -Command '$PROFILE' 2>/dev/null
)"; then
  echo "could not query the Windows PowerShell profile path" >&2
  exit 1
fi
windows_profile="$(printf '%s' "$windows_profile" | tr -d '\r')"
[ -n "$windows_profile" ] || {
  echo "Windows PowerShell returned an empty profile path" >&2
  exit 1
}

if ! profile="$(wslpath "$windows_profile")"; then
  echo "could not translate the Windows PowerShell profile path: $windows_profile" >&2
  exit 1
fi
[ -n "$profile" ] || {
  echo "translated Windows PowerShell profile path is empty" >&2
  exit 1
}

profile_dir="${profile%/*}"
mkdir -p "$profile_dir"

# Replace atomically so a PowerShell process never reads a partially written
# profile. Clean up the temporary file if anything fails before the rename.
tmp="${profile}.tmp"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cat >"$tmp" <<'EOF'
{{ include ".chezmoitemplates/windows-powershell-profile.ps1" -}}
EOF
mv "$tmp" "$profile"
trap - EXIT HUP INT TERM

echo "windows powershell profile updated in $profile"
{{ end -}}
